# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://localhost:8000,https://127.0.0.1:8000

# Database Configuration (Render will provide this automatically)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/studentbus_db

